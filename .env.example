# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env git'e eklenmez.
# Boş bırakılan değerler için varsayılanlar kullanılır.

# ------------------------------------------------------------------ Ortam
# local: bilgisayardaki Appium | bs: BrowserStack
RUN_ENV=local

# Aynı anda kaç senaryo koşsun (her biri ayrı cihaz ister). Varsayılan: 1
WORKERS=1

# ------------------------------------------------------------------ Uygulama (APK)
# Test edilecek APK. Göreli yol proje klasörüne göredir; tüm işletim sistemlerinde
# / kullanabilirsiniz. Boş bırakılırsa cihazda önceden kurulu uygulama kullanılır.
APP_PATH=./apps/seferci.apk

# Uygulama kimliği — normalde değiştirmeyin (varsayılan: com.hafriyat.mobile / .MainActivity)
APP_PACKAGE=
APP_ACTIVITY=

# ------------------------------------------------------------------ Local Appium
# Varsayılan: 127.0.0.1 / 4723
APPIUM_HOST=
APPIUM_PORT=

# Birden fazla cihaz/emülatör bağlıysa hangisi kullanılacak ('adb devices' çıktısındaki ad,
# ör. emulator-5554). Tek cihaz varsa boş bırakın.
DEVICE_UDID=

# ------------------------------------------------------------------ BrowserStack (RUN_ENV=bs)
BS_USERNAME=
BS_ACCESS_KEY=
# 'npm run upload:bs' APK'yı yükleyip bu değeri otomatik doldurur.
BS_APP_URL=
# Varsayılan: Samsung Galaxy S20
BS_DEVICE=
BS_OS_VERSION=
BS_BUILD_NAME=
